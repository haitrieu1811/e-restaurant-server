model Table {
  number      Int         @id
  token       String      @unique
  status      TableStatus @default(AVAILABLE)
  capacity    Int         @default(4)
  createdById Int?
  createdBy   User?       @relation("TableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  orders      Order[]

  @@index([deletedAt])
  @@map("Table")
}
