model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  createdById Int?
  createdBy   User?        @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  users       User[]
  permissions Permission[]

  @@index([deletedAt])
  @@map("Role")
}
